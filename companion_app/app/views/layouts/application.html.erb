<%= render "govuk_publishing_components/components/layout_for_admin", {
  environment: "development",
  product_name: "API Companion",
  browser_title: yield(:page_title)
} do %>
  <%= render "govuk_publishing_components/components/layout_header", {
    environment: "development",
    navigation_items: [
      {
        text: "Restaurants",
        href: restaurants_path,
        active: current_page?(restaurants_path)
      }
      # Add more items as desired.
    ]
  } %>
  <div class="govuk-width-container">
  <div id="main-content">
  <% if content_for?(:back_link) %>
    <div class="fade-in" style="animation-delay: 0.1s;">
      <%= render "govuk_publishing_components/components/back_link", href: yield(:back_link) %>
    </div>
  <% end %>

  <main class="govuk-main-wrapper">
    <% if content_for?(:page_title) %>
      <h1 class="govuk-heading-xl fade-in" id="page-title"><%= yield(:page_title) %></h1>
    <% end %>
    <%= yield %>
  </main>
  </div>

  </div>
  <%= render "govuk_publishing_components/components/layout_footer", {} %>
<% end %>

<style>
/* Shared fade-in animation */
.fade-in {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 0.8s forwards ease-out;
}

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Fade-out animation */
.fade-out {
  animation: fadeOut 0.5s forwards ease-out;
}

@keyframes fadeOut {
  to {
    opacity: 0;
    transform: translateY(-10px);
  }
}

/* Button press effect */
.animated-button {
  transition: transform 0.2s, box-shadow 0.2s;
}
.animated-button:active {
  transform: scale(0.96);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Fade out page content on link navigation (except target/_blank or ctrl+click)
  document.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', function(event) {
      if (!event.ctrlKey && !event.metaKey && !link.target && link.href) {
        const content = document.getElementById('main-content');
        if (content) {
          event.preventDefault();
          content.classList.add('fade-out');
          setTimeout(() => {
            window.location.href = link.href;
          }, 500);
        }
      }
    });
  });
});
</script>
