<% content_for :page_title, "Welcome to the Restaurant Recommendation app!" %>

<div class="landing-page">
  <section class="description">
    <div class="govuk-width-container">
      <p class="govuk-body-l fade-in" style="animation-delay: 0.2s;">
        Get personalized takeout recommendations with just a few clicks. Find the best local restaurants tailored to your taste!
      </p>
      <%= link_to "Get Started", new_recommendation_path, class: "govuk-button animated-button fade-in", style: "animation-delay: 0.4s;", id: "get-started-btn" %>
    </div>
  </section>

  <section class="how-it-works fade-in" style="animation-delay: 0.6s;">
    <div class="govuk-width-container">
      <h2 class="govuk-heading-m">How It Works</h2>
      <ol class="govuk-list govuk-list--number">
        <li class="fade-in" style="animation-delay: 0.8s;">Set your preferences.</li>
        <li class="fade-in" style="animation-delay: 1.0s;">Our system fetches matching restaurant data.</li>
        <li class="fade-in" style="animation-delay: 1.2s;">Receive personalized recommendations.</li>
      </ol>
    </div>
  </section>
</div>

<style>
.landing-page {
  overflow: hidden;
}

.fade-in {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 0.8s forwards ease-out;
}

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Button interaction animation */
.animated-button {
  transition: transform 0.2s, box-shadow 0.2s;
}

.animated-button:active {
  transform: scale(0.96);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
}

/* Fade-out transition */
.landing-page.fade-out {
  animation: fadeOut 0.5s forwards ease-out;
}

@keyframes fadeOut {
  to {
    opacity: 0;
    transform: translateY(-10px);
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const button = document.getElementById('get-started-btn');
  const landingPage = document.querySelector('.landing-page');

  button.addEventListener('click', function(event) {
    event.preventDefault();
    landingPage.classList.add('fade-out');
    setTimeout(() => {
      window.location.href = button.getAttribute('href');
    }, 500);
  });
});
</script>
